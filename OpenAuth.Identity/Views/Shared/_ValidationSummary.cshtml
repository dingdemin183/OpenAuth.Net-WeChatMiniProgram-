@if (ViewContext.ModelState.IsValid == false)
{
    <div class="alert alert-error">
        <span>&#9888;</span>
        <div>
            <strong>操作失败</strong>
            <div asp-validation-summary="All"></div>
        </div>
    </div>
}
@if (ViewContext.ModelState.IsValid == false)
{
    <div class="alert alert-danger">
        <strong>Error</strong>
        <div asp-validation-summary="All" class="danger"></div>
    </div>
}