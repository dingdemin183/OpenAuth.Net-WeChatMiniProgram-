@model OpenAuth.IdentityServer.Quickstart.Account.LoginViewModel

<div class="auth-card">
    <div class="auth-card-header">
        <div class="auth-icon">&#128274;</div>
        <h1>欢迎登录</h1>
        <p>登录 OpenAuth.Net 统一认证平台</p>
    </div>

    <partial name="_ValidationSummary" />

    @if (Model.EnableLocalLogin)
    {
        <form asp-route="Login">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label asp-for="Username">用户名</label>
                <input class="form-control" placeholder="请输入用户名" asp-for="Username" autofocus>
            </div>
            <div class="form-group">
                <label asp-for="Password">密码</label>
                <input type="password" class="form-control" placeholder="请输入密码" asp-for="Password" autocomplete="off">
            </div>

            @if (Model.AllowRememberLogin)
            {
                <div class="checkbox-group">
                    <input type="checkbox" asp-for="RememberLogin" id="RememberLogin">
                    <label for="RememberLogin">记住登录状态</label>
                </div>
            }

            <div class="btn-group">
                <button class="btn btn-primary" name="button" value="login">登 录</button>
                <button class="btn btn-secondary" name="button" value="cancel">取 消</button>
            </div>

            <div class="hint-text">
                测试账号：System/123456 | admin/admin | test/test
            </div>
        </form>
    }

    @if (Model.VisibleExternalProviders.Any())
    {
        @if (Model.EnableLocalLogin)
        {
            <div class="divider"><span>或使用其他方式登录</span></div>
        }
        <div class="external-providers">
            @foreach (var provider in Model.VisibleExternalProviders)
            {
                <a class="btn btn-outline"
                   asp-controller="External"
                   asp-action="Challenge"
                   asp-route-provider="@provider.AuthenticationScheme"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    @provider.DisplayName
                </a>
            }
        </div>
    }

    @if (!Model.EnableLocalLogin && !Model.VisibleExternalProviders.Any())
    {
        <div class="alert alert-warning">
            <span>&#9888;</span>
            <div>
                <strong>无效的登录请求</strong>
                <p>当前客户端未配置任何登录方式。</p>
            </div>
        </div>
    }
</div>
